{
  "name": "@thunder-bluephoenix/barcodejs",
  "version": "1.0.0",
  "description": "Zero-dependency barcode generator: QR, Micro QR, Data Matrix, PDF417, Aztec, Code 128, GS1, EAN/UPC, ISBN and more. SVG, PNG and canvas in Node and browsers, plus CLI, React and Vue.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    },
    "./render": "./src/render.js",
    "./linear": "./src/linear.js",
    "./code128": "./src/code128.js",
    "./qr": "./src/qr.js",
    "./datamatrix": "./src/datamatrix.js",
    "./react": {
      "types": "./frameworks.d.ts",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": "./frameworks.d.ts",
      "default": "./src/vue.js"
    },
    "./microqr": "./src/microqr.js",
    "./pdf417": "./src/pdf417.js",
    "./aztec": "./src/aztec.js",
    "./element": "./src/element.js",
    "./decode": {
      "types": "./decode.d.ts",
      "default": "./src/decode.js"
    },
    "./rmqr": "./src/rmqr.js",
    "./databar": "./src/databar.js",
    "./postal": "./src/postal.js"
  },
  "unpkg": "./dist/barcode.min.js",
  "jsdelivr": "./dist/barcode.min.js",
  "files": [
    "src/*.js",
    "dist/*.js",
    "index.d.ts",
    "bin",
    "frameworks.d.ts",
    "decode.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "esbuild src/browser.js --bundle --minify --format=iife --global-name=BarcodeJS --outfile=dist/barcode.min.js && esbuild src/index.js --bundle --minify --format=esm --outfile=dist/barcode.esm.min.js && esbuild src/index.js --bundle --format=cjs --platform=node --target=node18 --outfile=dist/index.cjs",
    "prepublishOnly": "npm test && npm run build",
    "test:zxing-cpp": "node test/zxing-cpp/cases.mjs .zxing-cpp-out && python3 test/zxing-cpp/check.py .zxing-cpp-out",
    "pretest": "npm run build --silent",
    "size": "node scripts/size.mjs",
    "version": "node -e \"const f='jsr.json',j=JSON.parse(require('fs').readFileSync(f));j.version=require('./package.json').version;require('fs').writeFileSync(f,JSON.stringify(j,null,2)+'\\n')\" && git add jsr.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thunder-BluePhoenix/BarcodeJS.git"
  },
  "keywords": [
    "barcode",
    "qr",
    "qrcode",
    "datamatrix",
    "code128",
    "gs1-128",
    "ean",
    "upc",
    "isbn",
    "svg",
    "png",
    "canvas",
    "pdf417",
    "aztec",
    "microqr",
    "gs1",
    "cli",
    "react",
    "vue"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vue/server-renderer": "^3.4.38",
    "@zxing/library": "^0.21.3",
    "bwip-js": "^4.11.4",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.4.38"
  },
  "bin": {
    "barcodejs": "bin/barcodejs.js"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./src/index.js"
}
